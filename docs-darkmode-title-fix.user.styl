/* ==UserStyle==
@name         Google Docs - Dark Mode Title Fix
@version      20260406.13.52
@namespace    github.com/ancandi
@description  userstyle/css to fix title duplication for ://flags `force-dark-mode`
@author       ancandi
@license      MIT
==/UserStyle== */

@-moz-document domain("docs.google.com") {
	.docs-title-input {
	    color: transparent !important; 
	}
	.docs-title-input:focus {
	    color: inherit !important;
	}
	.kix-appview-editor,
	.kix-appview-editor-container,
	.kix-pageless-view-canvas,
	.kix-pageless-view-body,
	.docs-restyle-pageless-page-content,
	.kix-page-pageless {
	    color-scheme: only light !important;
	}
}
